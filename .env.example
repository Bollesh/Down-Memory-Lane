# Slack (api.slack.com/apps → your app)
SLACK_BOT_TOKEN=xoxb-...          # OAuth & Permissions → Bot User OAuth Token
SLACK_APP_TOKEN=xapp-...          # Basic Information → App-Level Tokens (scope: connections:write)

# Replicate (replicate.com/account/api-tokens)
REPLICATE_API_TOKEN=r8_...

# Your trained Flux LoRA model: owner/name, or owner/name:version to pin a version
REPLICATE_MODEL=your-username/your-model

# The trigger word you entered when training the model on Replicate
TRIGGER_WORD=TOK
